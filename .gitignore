# Secrets — NEVER commit
.secrets/
*.env
.env

# Environment / caches
venv/
.venv/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/
build/
dist/

# Datasets are fetched from public sources on first use and cached here, with
# row-count validation. Regenerable, and not ours to redistribute.
data/

# Synthetic output is regenerable; the JSON records the audits read are committed.
results/**/*.csv
results/**/*.log
# Two exceptions: the audit reads these to hold the paper to what configuration A's output
# actually contains (two of six race groups -- review A3). 600 rows each.
!results/nh_nmin0/synthetic_cortec_draw0.csv
!results/nh_nmin0/seed42_draw0.csv
# The draws the audits and regeneration scripts score directly, so the paper's numbers are
# re-derivable from the repository alone: the corrected-mechanism Adult arm (§7.2 Result 1′, five
# draws of 300 rows), the cohort-wise NHANES arm (§F.1, two draws of 600 rows), and the matched
# header-only control on the registry (§7.1.3, two draws of 1,000 rows).
!results/v5_corrected/synthetic_cortec_draw0.csv
!results/v5_corrected_d2/synthetic_cortec_draw*.csv
!results/nh_nmin0_cohortwise/synthetic_cortec_draw0.csv
!results/nh_nmin0_cohortwise_d2/synthetic_cortec_draw0.csv
!results/l12_renal_matched/synthetic_header_only_draw0.csv
!results/l12_renal_matched_d2/synthetic_header_only_draw0.csv
# Inputs of the regeneration scripts' reproduction checks and comparisons: configuration B's two
# NHANES draws (§F.1), the shipped Adult arm re-scored before the corrected arm is trusted (§7.2
# Result 1′), and the registry arms the matched control is compared with (§7.1.3).
!results/nh_nmin150/synthetic_cortec_draw0.csv
!results/nh_nmin150/seed42_draw0.csv
