# Secrets: never commit
.secrets/
*.env
.env

# Environment and caches
venv/
.venv/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/
build/
dist/

# Datasets are fetched from public sources on first use and cached here, with row-count
# validation. Regenerable, and not ours to redistribute.
data/

# Run output is not published. The one exception is the frozen auto-configurations, which the
# *_auto dataset specifications load by file and must never re-derive.
results/*
!results/autoconfig/
results/autoconfig/*
!results/autoconfig/*.json
