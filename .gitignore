# Secrets: never commit
.secrets/
*.env
.env

# Environment, build and caches
venv/
.venv/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/
build/
dist/

# Datasets are fetched from public sources on first use and cached here; not ours to redistribute.
research/data/

# Run output is not published. The exceptions are the frozen auto-configurations, which the
# *_auto dataset specifications load by file and must never re-derive, and the one development
# measurement the design notes quote with its own files.
research/results/*
!research/results/autoconfig/
research/results/autoconfig/*
!research/results/autoconfig/*.json
!research/results/development/
